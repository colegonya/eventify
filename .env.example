# Upstash Redis (Vercel's current KV integration — "Vercel KV" is deprecated).
# Add the Upstash Redis integration in the Vercel dashboard and it will inject
# these automatically in production. For local dev, copy this file to .env.local
# and fill in the values from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Starting passcode for the login gate. Required — the app throws at startup if
# this isn't set. Pick something only your chapter's officers know. Once you're
# running, you can change the passcode from the Settings tab; the new one is
# stored in your database and this value stops being used.
SITE_PASSCODE=

# Everything below is a DEFAULT, not a setting. All of it is editable from the
# Settings tab once the app is running, and anything saved there wins over what
# you put here. You only need these if you want a deployment to start out with
# your own name and colors already applied.

# Your chapter's name, shown throughout the app (e.g. "Blank Social Calendar").
# Defaults to "Blank" if unset, so it's obvious setup isn't finished yet.
NEXT_PUBLIC_CHAPTER_NAME=

# Brand colors. Leave unset to use the default palette in globals.css.
NEXT_PUBLIC_BRAND_PRIMARY=
NEXT_PUBLIC_BRAND_ACCENT=
NEXT_PUBLIC_BRAND_ACCENT_DEEP=
NEXT_PUBLIC_BRAND_INK=
