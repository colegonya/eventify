# Upstash Redis (Vercel's current KV integration — "Vercel KV" is deprecated).
# Add the Upstash Redis integration in the Vercel dashboard and it will inject
# these automatically in production. For local dev, copy this file to .env.local
# and fill in the values from the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your chapter's name, shown throughout the app (e.g. "Blank Social Calendar").
# Defaults to "Blank" if unset, so it's obvious setup isn't finished yet.
NEXT_PUBLIC_CHAPTER_NAME=

# Shared passcode for the login gate. Required — the app throws at startup
# if this isn't set. Pick something only your chapter's officers know.
SITE_PASSCODE=
